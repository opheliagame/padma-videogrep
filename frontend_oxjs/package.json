{
  "name": "padma-videogrep-oxjs",
  "version": "1.0.0",
  "description": "Video search and clip extraction tool built with OxJS",
  "main": "index.js",
  "scripts": {
    "build:parser": "nearleyc app/utils/scene-query.ne -o app/utils/nearleyParser.js",
    "build:bundle": "webpack",
    "build": "npm run build:parser && npm run build:bundle",
    "dev": "python3 -m http.server 8000"
  },
  "keywords": [
    "video",
    "search",
    "clips",
    "parsing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "nearley": "^2.20.1",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1"
  }
}
