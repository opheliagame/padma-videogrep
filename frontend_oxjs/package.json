{
  "name": "padma-videogrep-oxjs",
  "version": "1.0.0",
  "description": "Video search and clip extraction tool built with OxJS",
  "main": "index.js",
  "scripts": {
    "build:parser": "nearleyc app/utils/scene-query.ne -o app/utils/nearleyParser.js",
    "build:bundle": "webpack",
    "build": "npm run build:parser && npm run build:bundle && vite build",
    "test": "vitest run app/components/Header/Header.test.js app/views/About/AboutView.test.js",
    "dev": "vite",
    "predev": "npm run build:parser && npm run build:bundle"
  },
  "keywords": [
    "video",
    "search",
    "clips",
    "parsing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jsdom": "^26.1.0",
    "nearley": "^2.20.1",
    "vite": "^5.0.11",
    "vitest": "^2.1.9",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1"
  }
}
