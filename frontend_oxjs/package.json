{
  "name": "padma-videogrep-oxjs",
  "version": "1.0.0",
  "description": "Video search and clip extraction tool built with OxJS",
  "main": "index.js",
  "scripts": {
    "build:parser": "nearleyc app/core/SceneParser/scene-query.ne -o app/core/SceneParser/nearleyParser.js",
    "build": "npm run build:parser && vite build",
    "test": "vitest run app/api app/views app/components app/core",
    "dev": "vite",
    "predev": "npm run build:parser"
  },
  "keywords": [
    "video",
    "search",
    "clips",
    "parsing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jsdom": "^26.1.0",
    "nearley": "^2.20.1",
    "vite": "^5.0.11",
    "vitest": "^2.1.9"
  }
}
